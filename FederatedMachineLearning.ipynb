    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "# -----------------------------\n",
    "# 1) Features/Ziel\n",
    "# -----------------------------\n",
    "X = df_encoded.drop(['ID', 'Status'], axis=1)\n",
    "y = df_encoded['Status']\n",
    "\n",
    "# -----------------------------\n",
    "# 2) Train/Test-Split (20% Test)\n",
    "# -----------------------------\n",
    "X_train_full, X_test, y_train_full, y_test = train_test_split(\n",
    "    X, y, test_size=0.20, random_state=50, stratify=y\n",
    ")\n",
    "\n",
    "# -----------------------------\n",
    "# 3) Train/Val-Split aus dem Trainingsanteil (25% von Train -> 60/20/20 gesamt)\n",
    "# -----------------------------\n",
    "X_train, X_val, y_train, y_val = train_test_split(\n",
    "    X_train_full, y_train_full, test_size=0.25, random_state=50, stratify=y_train_full\n",
    ")\n",
    "\n",
    "# -----------------------------\n",
    "# 4) Numerische Features definieren + prüfen\n",
    "#    (Achtung auf Schreibweise/Leerzeichen!)\n",
    "# -----------------------------\n",
    "numeric_features = ['Children', 'Income', 'Age', 'Years_Experience', 'Total_Family', 'Good rate']\n",
    "\n",
    "# Nur nutzen, was wirklich existiert:\n",
    "numeric_features = [c for c in numeric_features if c in X_train.columns]\n",
    "if len(numeric_features) == 0:\n",
    "    raise ValueError(\"Keine der angegebenen numeric_features ist in den Daten vorhanden.\")\n",
    "\n",
    "# Optional: sicherstellen, dass diese Spalten numerisch sind (z. B. falls als 'object' eingelesen)\n",
    "for c in numeric_features:\n",
    "    if not (str(X_train[c].dtype).startswith(('float', 'int'))):\n",
